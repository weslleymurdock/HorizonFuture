<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Routes).Assembly"
            AdditionalAssemblies="new[] { typeof(MainLayout).Assembly }"
            NotFoundPage="@typeof(NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="my-4">
                                Acesso negado: sua conta não possui a permissão necessária para acessar esta página.
                            </MudAlert>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/courses">
                                Ir para Cursos
                            </MudButton>
                        </MudContainer>
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
