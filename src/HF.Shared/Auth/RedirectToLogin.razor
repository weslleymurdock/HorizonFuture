@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

@code {
    [Parameter]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = AuthenticationStateTask != null
            ? await AuthenticationStateTask
            : await AuthStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            // User is already authenticated. Do not bounce to login.
            return;
        }

        var currentUri = Navigation.ToBaseRelativePath(Navigation.Uri);
        var targetPath = !string.IsNullOrWhiteSpace(currentUri) && !currentUri.StartsWith("/")
            ? $"/{currentUri}"
            : currentUri;

        // Ensure target is not already login to avoid redirection loop
        var loginUrl = string.IsNullOrWhiteSpace(targetPath) || targetPath == "/" || targetPath.StartsWith("/auth/login", StringComparison.OrdinalIgnoreCase)
            ? "/auth/login"
            : $"/auth/login?returnUrl={Uri.EscapeDataString(targetPath)}";

        Navigation.NavigateTo(loginUrl, replace: true);
    }
}
