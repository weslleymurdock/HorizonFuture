@page "/subjects/create"
@attribute [Authorize]
@inject SubjectCreatePageModel PageModel
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-8">
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Default"
               Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo("/subjects"))"
               aria-label="Voltar para a lista de disciplinas">
        Voltar para Disciplinas
    </MudButton>

    <MudCard Elevation="4" Class="pa-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" GutterBottom="true">Cadastrar Nova Disciplina</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Preencha os campos abaixo para registrar uma disciplina ou componente curricular.
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    <div class="d-flex flex-column gap-2">
                        <span>@PageModel.SuccessMessage</span>
                        @if (PageModel.CreatedSubject is not null)
                        {
                            <div class="d-flex gap-2 mt-2">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Inherit"
                                           Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/subjects/{PageModel.CreatedSubject.Id}"))">
                                    Ver Detalhes da Disciplina
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Inherit"
                                           Size="Size.Small"
                                           OnClick="() => PageModel.ResetForm()">
                                    Cadastrar Outra Disciplina
                                </MudButton>
                            </div>
                        }
                    </div>
                </MudAlert>
            }

            @if (PageModel.IsForbidden)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">
                    Acesso negado: seu usuário não possui a permissão necessária para criar disciplinas (Subjects.Create).
                </MudAlert>
            }

            <MudForm @onsubmit="() => PageModel.CreateSubjectAsync()">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="8">
                        <MudTextField T="string"
                                      Label="Nome da Disciplina"
                                      @bind-Value="PageModel.Name"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="O nome da disciplina é obrigatório"
                                      MaxLength="150"
                                      Counter="150"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Nome de identificação da matéria (até 150 caracteres)"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Nome da disciplina" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Label="Código da Disciplina"
                                      @bind-Value="PageModel.Code"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="O código da disciplina é obrigatório"
                                      MaxLength="30"
                                      Counter="30"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Código único (ex: MAT-101, FIS-01)"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Código da disciplina" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="6">
                        <MudNumericField T="int"
                                         Label="Carga Horária (horas)"
                                         @bind-Value="PageModel.WorkloadHours"
                                         Immediate="true"
                                         Min="1"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         HelperText="Duração total em horas (maior que zero)"
                                         Disabled="@PageModel.IsBusy"
                                         aria-label="Carga horária em horas" />
                    </MudItem>

                    <MudItem xs="12" sm="6" md="6">
                        <MudSelect T="SubjectStatus"
                                   Label="Status Operacional"
                                   @bind-Value="PageModel.Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@PageModel.IsBusy"
                                   aria-label="Status operacional da disciplina">
                            <MudSelectItem T="SubjectStatus" Value="SubjectStatus.Active">Ativo</MudSelectItem>
                            <MudSelectItem T="SubjectStatus" Value="SubjectStatus.Inactive">Inativo</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Curso Vinculado (CourseId)"
                                      @bind-Value="PageModel.CourseId"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="ID opcional do curso pai desta disciplina"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Identificador do curso vinculado" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Unidade Escolar (SchoolUnitId)"
                                      @bind-Value="PageModel.SchoolUnitId"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Identificador opcional da unidade escolar de oferta"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Identificador da unidade escolar" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Label="Descrição / Ementa Curricular"
                                      @bind-Value="PageModel.Description"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Conteúdo programático ou objetivos pedagógicos da disciplina"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Descrição da disciplina" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end gap-2 mt-6">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="@(() => Navigation.NavigateTo("/subjects"))"
                               Disabled="@PageModel.IsBusy"
                               aria-label="Cancelar cadastro">
                        Cancelar
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit"
                               OnClick="() => PageModel.CreateSubjectAsync()"
                               Disabled="@PageModel.IsBusy"
                               aria-label="Salvar nova disciplina">
                        @if (PageModel.IsBusy)
                        {
                            <MudProgressCircular Class="ms-n1 me-1" Size="Size.Small" Indeterminate="true" />
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <span>Cadastrar Disciplina</span>
                        }
                    </MudButton>
                </div>
            </MudForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        PageModel.PropertyChanged += HandlePropertyChanged;
    }

    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PageModel.PropertyChanged -= HandlePropertyChanged;
    }
}

