@page "/auth/forgot-password"
@inject ForgotPasswordPageModel PageModel

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-8">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Recuperação de Senha</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Digite seu email cadastrado para receber as instruções de recuperação
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    @PageModel.SuccessMessage
                </MudAlert>
            }

            <MudForm @onsubmit="() => PageModel.SendForgotPasswordAsync()">
                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="PageModel.Email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="O email é obrigatório"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Email para recuperação de senha"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Disabled="@PageModel.IsBusy" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2"
                           ButtonType="ButtonType.Submit"
                           OnClick="() => PageModel.SendForgotPasswordAsync()"
                           Disabled="@PageModel.IsBusy"
                           aria-label="Enviar instruções de recuperação">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Enviando...</MudText>
                    }
                    else
                    {
                        <MudText>Enviar Instruções</MudText>
                    }
                </MudButton>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column align-center gap-2 pt-2">
            <MudLink Href="/auth/reset-password" Color="Color.Primary" Typo="Typo.body2">
                Já possui um código de redefinição? Redefina sua senha
            </MudLink>
            <MudDivider Class="my-2" Style="width: 100%;" />
            <MudLink Href="/auth/login" Color="Color.Secondary" Typo="Typo.body2">
                Voltar para o Login
            </MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        PageModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
    }
}
