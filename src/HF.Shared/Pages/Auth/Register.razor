@page "/auth/register"
@attribute [AllowAnonymous]
@inject RegisterPageModel PageModel

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-8">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Criar Nova Conta</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Preencha os dados abaixo para registrar-se
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    @PageModel.SuccessMessage
                </MudAlert>
            }

            <MudForm @onsubmit="() => PageModel.RegisterAsync()">
                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="PageModel.Email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="O email é obrigatório"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Email de cadastro"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Senha"
                              @bind-Value="PageModel.Password"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="A senha é obrigatória"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Senha de cadastro"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Confirmar Senha"
                              @bind-Value="PageModel.ConfirmPassword"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="A confirmação de senha é obrigatória"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Confirmação da Senha"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockReset"
                              Disabled="@PageModel.IsBusy" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2"
                           ButtonType="ButtonType.Submit"
                           OnClick="() => PageModel.RegisterAsync()"
                           Disabled="@PageModel.IsBusy"
                           aria-label="Registrar nova conta">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Cadastrando...</MudText>
                    }
                    else
                    {
                        <MudText>Registrar</MudText>
                    }
                </MudButton>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column align-center gap-2 pt-2">
            <MudLink Href="/auth/confirm-email" Color="Color.Primary" Typo="Typo.body2">
                Já recebeu um código de confirmação? Ative aqui
            </MudLink>
            <MudDivider Class="my-2" Style="width: 100%;" />
            <MudText Typo="Typo.body2">
                Já possui conta? <MudLink Href="/auth/login" Color="Color.Secondary">Faça login</MudLink>
            </MudText>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        PageModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
    }
}
