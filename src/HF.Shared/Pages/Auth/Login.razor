@page "/auth/login"
@attribute [AllowAnonymous]
@inject LoginPageModel PageModel
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-8">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Entrar no Horizon</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Acesse sua conta para continuar
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    @PageModel.SuccessMessage
                </MudAlert>
            }

            <MudForm @onsubmit="SubmitAsync">
                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="PageModel.Email"
                              Immediate="true"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="O email é obrigatório"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Senha"
                              @bind-Value="PageModel.Password"
                              Immediate="true"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="A senha é obrigatória"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="@PageModel.IsBusy" />

                <MudSwitch @bind-Value="PageModel.ShowTwoFactor"
                           Label="Possui autenticação em dois fatores (2FA)?"
                           Color="Color.Primary"
                           Class="mb-3" />

                @if (PageModel.ShowTwoFactor)
                {
                    <MudTextField T="string"
                                  Label="Código 2FA (Authenticator)"
                                  @bind-Value="PageModel.TwoFactorCode"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3"
                                  Placeholder="Ex: 123456"
                                  Disabled="@PageModel.IsBusy" />

                    <MudTextField T="string"
                                  Label="Código de Recuperação 2FA (Opcional)"
                                  @bind-Value="PageModel.TwoFactorRecoveryCode"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="mb-3"
                                  Placeholder="Código de backup"
                                  Disabled="@PageModel.IsBusy" />
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2 login-submit-btn"
                           ButtonType="ButtonType.Submit"
                           Disabled="@PageModel.IsBusy">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Entrando...</MudText>
                    }
                    else
                    {
                        <MudText>Entrar</MudText>
                    }
                </MudButton>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column align-center gap-2 pt-2">
            <MudLink Href="/auth/forgot-password" Color="Color.Primary" Typo="Typo.body2">
                Esqueceu sua senha?
            </MudLink>
            <MudDivider Class="my-2" Style="width: 100%;" />
            <MudText Typo="Typo.body2">
                Não tem uma conta? <MudLink Href="/auth/register" Color="Color.Secondary">Cadastre-se aqui</MudLink>
            </MudText>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? CascadingAuthState { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool _hasNavigated;

    protected override async Task OnInitializedAsync()
    {
        PageModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
        await CheckAuthenticatedAndRedirectAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CheckAuthenticatedAndRedirectAsync();
    }

    private async Task CheckAuthenticatedAndRedirectAsync()
    {
        if (_hasNavigated)
        {
            return;
        }

        AuthenticationState? authState = null;
        if (CascadingAuthState != null)
        {
            authState = await CascadingAuthState;
        }
        else
        {
            authState = await AuthStateProvider.GetAuthenticationStateAsync();
        }

        if (authState?.User.Identity?.IsAuthenticated == true)
        {
            _hasNavigated = true;
            var destination = IsSafeLocalUrl(ReturnUrl) ? ReturnUrl! : "/courses";
            Navigation.NavigateTo(destination, replace: true);
        }
    }

    private async Task SubmitAsync()
    {
        if (PageModel.IsBusy || _hasNavigated)
        {
            return;
        }

        var success = await PageModel.LoginAsync();
        if (success)
        {
            // Confirm and notify the authentication tree with the updated session
            if (AuthStateProvider is HorizonAuthenticationStateProvider horizonProvider)
            {
                await horizonProvider.RefreshAuthenticationStateAsync();
            }
            else
            {
                await AuthStateProvider.GetAuthenticationStateAsync();
            }

            // Yield execution to allow CascadingAuthenticationState to propagate to all descendants
            await Task.Yield();

            if (!_hasNavigated)
            {
                _hasNavigated = true;
                var destination = IsSafeLocalUrl(ReturnUrl) ? ReturnUrl! : "/courses";
                Navigation.NavigateTo(destination, replace: true);
            }
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private static bool IsSafeLocalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        if (!url.StartsWith('/') || url.StartsWith("//") || url.StartsWith("/\\"))
        {
            return false;
        }

        var queryIdx = url.IndexOf('?');
        var path = queryIdx >= 0 ? url[..queryIdx] : url;
        if (path.Contains(':'))
        {
            return false;
        }

        if (path.StartsWith("/auth/login", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }
}
