@page "/auth/reset-password"
@inject ResetPasswordPageModel PageModel

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6 mb-8">
    <MudCard Elevation="4" Class="pa-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Redefinição de Senha</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    Informe seu email, o código recebido e a nova senha
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    @PageModel.SuccessMessage
                </MudAlert>
            }

            <MudForm @onsubmit="() => PageModel.ResetPasswordAsync()">
                <MudTextField T="string"
                              Label="Email"
                              @bind-Value="PageModel.Email"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="O email é obrigatório"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Email da conta"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Código de Redefinição"
                              @bind-Value="PageModel.ResetCode"
                              Required="true"
                              RequiredError="O código de redefinição é obrigatório"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Código de verificação de redefinição"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Key"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Nova Senha"
                              @bind-Value="PageModel.NewPassword"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="A nova senha é obrigatória"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Nova Senha"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              Disabled="@PageModel.IsBusy" />

                <MudTextField T="string"
                              Label="Confirmar Nova Senha"
                              @bind-Value="PageModel.ConfirmNewPassword"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="A confirmação de senha é obrigatória"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mb-4"
                              aria-label="Confirmação da Nova Senha"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.LockReset"
                              Disabled="@PageModel.IsBusy" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Class="mt-2"
                           ButtonType="ButtonType.Submit"
                           OnClick="() => PageModel.ResetPasswordAsync()"
                           Disabled="@PageModel.IsBusy"
                           aria-label="Confirmar redefinição de senha">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Redefinindo...</MudText>
                    }
                    else
                    {
                        <MudText>Redefinir Senha</MudText>
                    }
                </MudButton>
            </MudForm>
        </MudCardContent>

        <MudCardActions Class="d-flex flex-column align-center gap-2 pt-2">
            <MudLink Href="/auth/login" Color="Color.Primary" Typo="Typo.body2">
                Ir para o Login
            </MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Code { get; set; }

    protected override void OnInitialized()
    {
        PageModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
        if (!string.IsNullOrWhiteSpace(Email))
        {
            PageModel.Email = Email;
        }
        if (!string.IsNullOrWhiteSpace(Code))
        {
            PageModel.ResetCode = Code;
        }
    }
}
