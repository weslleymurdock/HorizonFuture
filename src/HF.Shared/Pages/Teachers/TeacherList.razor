@page "/teachers"
@attribute [Authorize]
@inject TeacherListPageModel PageModel
@inject NavigationManager Navigation
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center gap-4 mb-6">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Professores</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gerenciamento do corpo docente, especialidades pedagógicas e lotações.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/teachers/create"))"
                   aria-label="Cadastrar Novo Professor">
            Novo Professor
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
            @PageModel.ErrorMessage
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.SuccessMessage = null">
            @PageModel.SuccessMessage
        </MudAlert>
    }

    @if (PageModel.IsForbidden)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">
            Acesso negado: seu perfil não possui a permissão necessária para visualizar a lista de professores (Teachers.Read).
        </MudAlert>
    }

    @if (PageModel.IsUnauthorized)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
            Sua sessão expirou ou você não está autenticado. Faça login para acessar esta funcionalidade.
        </MudAlert>
    }

    <!-- Barra de Filtros e Busca -->
    <MudCard Elevation="2" Class="pa-4 mb-6">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Label="Buscar (matrícula, especialidade, etc.)"
                              @bind-Value="PageModel.SearchText"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              aria-label="Filtrar professores por termo de busca" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="TeacherStatus?"
                           Label="Status Operacional"
                           @bind-Value="PageModel.StatusFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           aria-label="Filtrar professores por status">
                    <MudSelectItem T="TeacherStatus?" Value="@((TeacherStatus?)null)">Todos os Status</MudSelectItem>
                    <MudSelectItem T="TeacherStatus?" Value="@((TeacherStatus?)TeacherStatus.Active)">Ativo</MudSelectItem>
                    <MudSelectItem T="TeacherStatus?" Value="@((TeacherStatus?)TeacherStatus.OnLeave)">Em Licença</MudSelectItem>
                    <MudSelectItem T="TeacherStatus?" Value="@((TeacherStatus?)TeacherStatus.Inactive)">Inativo</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudTextField T="string"
                              Label="Especialidade"
                              @bind-Value="PageModel.SpecialtyFilter"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              aria-label="Filtrar por especialidade" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudTextField T="string"
                              Label="Unidade Escolar"
                              @bind-Value="PageModel.SchoolUnitIdFilter"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              aria-label="Filtrar por unidade escolar" />
            </MudItem>

            <MudItem xs="12" sm="12" md="2" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="() => PageModel.LoadTeachersAsync()"
                           Disabled="@PageModel.IsBusy"
                           aria-label="Aplicar filtros de professores">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                        <span>Carregando...</span>
                    }
                    else
                    {
                        <span>Filtrar</span>
                    }
                </MudButton>

                <MudTooltip Text="Limpar Filtros">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="() => PageModel.ResetFiltersAsync()"
                                   Disabled="@PageModel.IsBusy"
                                   aria-label="Limpar todos os filtros" />
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudCard>

    <!-- Tabela de Professores -->
    <MudTable Items="PageModel.FilteredTeachers"
              Dense="true"
              Hover="true"
              Striped="true"
              Elevation="3"
              Loading="@PageModel.IsBusy"
              Class="mb-4">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<TeacherItemDto, object>(x => x.EmployeeNumber)">Matrícula</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TeacherItemDto, object>(x => x.Specialty)">Especialidade</MudTableSortLabel></MudTh>
            <MudTh>Formação Acadêmica</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<TeacherItemDto, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
            <MudTh>Data de Contratação</MudTh>
            <MudTh>Unidade Escolar</MudTh>
            <MudTh Style="text-align: right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Matrícula">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                    @context.EmployeeNumber
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Especialidade">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@context.Specialty</MudText>
                @if (!string.IsNullOrWhiteSpace(context.Bio))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate" Style="max-width: 250px; display: block;">
                        @context.Bio
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="Formação Acadêmica">
                @(string.IsNullOrWhiteSpace(context.AcademicDegree) ? "Não informada" : context.AcademicDegree)
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                    @GetStatusLabel(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Data de Contratação">
                @(context.HireDate.HasValue ? context.HireDate.Value.ToString("dd/MM/yyyy") : "Não informada")
            </MudTd>
            <MudTd DataLabel="Unidade Escolar">
                @(string.IsNullOrWhiteSpace(context.SchoolUnitId) ? "Todas as Unidades" : context.SchoolUnitId)
            </MudTd>
            <MudTd DataLabel="Ações" Style="text-align: right;">
                <div class="d-flex justify-end gap-1">
                    <MudTooltip Text="Visualizar detalhes">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       aria-label="@($"Visualizar detalhes do professor {context.EmployeeNumber}")"
                                       OnClick="@(() => Navigation.NavigateTo($"/teachers/{context.Id}"))" />
                    </MudTooltip>

                    <MudTooltip Text="Editar professor">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       aria-label="@($"Editar professor {context.EmployeeNumber}")"
                                       OnClick="@(() => Navigation.NavigateTo($"/teachers/{context.Id}/edit"))" />
                    </MudTooltip>

                    <MudTooltip Text="Excluir professor">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@(PageModel.IsDeleting && PageModel.DeletingTeacherId == context.Id)"
                                       aria-label="@($"Excluir professor {context.EmployeeNumber}")"
                                       OnClick="@(() => ConfirmDeleteAsync(context))" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" GutterBottom="true">
                    Nenhum professor encontrado
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Não há professores cadastrados com os critérios informados.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Navigation.NavigateTo("/teachers/create"))">
                    Cadastrar Primeiro Professor
                </MudButton>
            </div>
        </NoRecordsContent>

        <LoadingContent>
            <div class="pa-8 text-center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Class="mb-2" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Carregando catálogo de professores...</MudText>
            </div>
        </LoadingContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                           RowsPerPageString="Linhas por página:"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        PageModel.PropertyChanged += HandlePropertyChanged;
        await PageModel.LoadTeachersAsync();
    }

    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PageModel.PropertyChanged -= HandlePropertyChanged;
    }

    private async Task ConfirmDeleteAsync(TeacherItemDto teacher)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Exclusão",
            $"Deseja realmente excluir o professor de matrícula '{teacher.EmployeeNumber}' (Especialidade: {teacher.Specialty})? Esta operação é irreversível.",
            yesText: "Excluir Professor",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await PageModel.DeleteTeacherAsync(teacher.Id);
        }
    }

    private static Color GetStatusColor(TeacherStatus status) => status switch
    {
        TeacherStatus.Active => Color.Success,
        TeacherStatus.OnLeave => Color.Warning,
        TeacherStatus.Inactive => Color.Default,
        _ => Color.Default
    };

    private static string GetStatusLabel(TeacherStatus status) => status switch
    {
        TeacherStatus.Active => "Ativo",
        TeacherStatus.OnLeave => "Em Licença",
        TeacherStatus.Inactive => "Inativo",
        _ => status.ToString()
    };
}

