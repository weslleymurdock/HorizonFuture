@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout
@inject NotFoundPageModel PageModel
<PageTitle>@PageModel.Title</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@PageModel.Legend</MudText>
<MudText Class="mb-8">@PageModel.Description</MudText>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Go to Home</MudButton>
