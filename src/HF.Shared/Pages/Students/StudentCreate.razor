@page "/students/create"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject StudentCreatePageModel PageModel
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-8">
    <MudButton Variant="Variant.Text"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Color="Color.Default"
               Class="mb-4"
               OnClick="@(() => Navigation.NavigateTo("/students"))"
               aria-label="Voltar para a lista de alunos">
        Voltar para Alunos
    </MudButton>

    <MudCard Elevation="4" Class="pa-6">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5" GutterBottom="true">Cadastrar Novo Aluno</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Preencha os dados cadastrais, documentação e contatos do responsável para registro do aluno.
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>

        <MudCardContent>
            @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
                    @PageModel.ErrorMessage
                </MudAlert>
            }

            @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
            {
                <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled">
                    <div class="d-flex flex-column gap-2">
                        <span>@PageModel.SuccessMessage</span>
                        @if (PageModel.CreatedStudent is not null)
                        {
                            <div class="d-flex gap-2 mt-2">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Inherit"
                                           Size="Size.Small"
                                           OnClick="@(() => Navigation.NavigateTo($"/students/{PageModel.CreatedStudent.Id}"))">
                                    Ver Detalhes do Aluno
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Inherit"
                                           Size="Size.Small"
                                           OnClick="() => PageModel.ResetForm()">
                                    Cadastrar Outro Aluno
                                </MudButton>
                            </div>
                        }
                    </div>
                </MudAlert>
            }

            @if (PageModel.IsForbidden)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">
                    Acesso negado: seu usuário não possui a permissão necessária para criar alunos (Students.Create).
                </MudAlert>
            }

            <MudForm @onsubmit="() => PageModel.CreateStudentAsync()">
                <MudGrid Spacing="2">
                    <!-- Informações Principais de Identificação -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-2 mb-1" Color="Color.Primary">
                            Identificação do Aluno
                        </MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="ID do Usuário (UserId)"
                                      @bind-Value="PageModel.UserId"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="O ID do usuário é obrigatório"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Identificador do usuário no sistema de autenticação"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="ID do Usuário" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Número de Matrícula"
                                      @bind-Value="PageModel.RegistrationNumber"
                                      Immediate="true"
                                      Required="true"
                                      RequiredError="O número de matrícula é obrigatório"
                                      MaxLength="50"
                                      Counter="50"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Código de matrícula único (ex: MAT-2026-001)"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Número de matrícula" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Data de Nascimento"
                                       @bind-Date="PageModel.DateOfBirth"
                                       Editable="true"
                                       Required="true"
                                       RequiredError="A data de nascimento é obrigatória"
                                       DateFormat="dd/MM/yyyy"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       HelperText="Deve ser anterior à data de hoje"
                                       Disabled="@PageModel.IsBusy"
                                       aria-label="Data de nascimento" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Data de Matrícula/Ingresso"
                                       @bind-Date="PageModel.EnrollmentDate"
                                       Editable="true"
                                       DateFormat="dd/MM/yyyy"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       HelperText="Data formal de ingresso"
                                       Disabled="@PageModel.IsBusy"
                                       aria-label="Data de ingresso" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="StudentStatus"
                                   Label="Status Inicial"
                                   @bind-Value="PageModel.Status"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@PageModel.IsBusy"
                                   aria-label="Status inicial do aluno">
                            <MudSelectItem T="StudentStatus" Value="@StudentStatus.Active">Ativo</MudSelectItem>
                            <MudSelectItem T="StudentStatus" Value="@StudentStatus.Inactive">Inativo</MudSelectItem>
                            <MudSelectItem T="StudentStatus" Value="@StudentStatus.Graduated">Graduado</MudSelectItem>
                            <MudSelectItem T="StudentStatus" Value="@StudentStatus.Suspended">Suspenso</MudSelectItem>
                            <MudSelectItem T="StudentStatus" Value="@StudentStatus.Transferred">Transferido</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Label="Unidade Escolar (SchoolUnitId)"
                                      @bind-Value="PageModel.SchoolUnitId"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="ID da unidade escolar onde o aluno está matriculado (opcional)"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Unidade Escolar" />
                    </MudItem>

                    <!-- Responsável Legal -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-4 mb-1" Color="Color.Primary">
                            Responsável Legal
                        </MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12" md="5">
                        <MudTextField T="string"
                                      Label="Nome do Responsável"
                                      @bind-Value="PageModel.GuardianName"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Nome do responsável" />
                    </MudItem>

                    <MudItem xs="12" md="3">
                        <MudTextField T="string"
                                      Label="Parentesco"
                                      @bind-Value="PageModel.GuardianRelationship"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Ex: Mãe, Pai, Avô(ó), Tutor"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Grau de parentesco" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField T="string"
                                      Label="Telefone do Responsável"
                                      @bind-Value="PageModel.GuardianPhone"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Telefone do responsável" />
                    </MudItem>

                    <!-- Contato de Emergência -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-4 mb-1" Color="Color.Primary">
                            Contato de Emergência
                        </MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Nome do Contato de Emergência"
                                      @bind-Value="PageModel.EmergencyContactName"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Nome do contato de emergência" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField T="string"
                                      Label="Telefone de Emergência"
                                      @bind-Value="PageModel.EmergencyContactPhone"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Telefone do contato de emergência" />
                    </MudItem>

                    <!-- Observações de Apoio e Saúde -->
                    <MudItem xs="12">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mt-4 mb-1" Color="Color.Primary">
                            Necessidades Especiais e Informações de Saúde
                        </MudText>
                        <MudDivider Class="mb-3" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Label="Necessidades Especiais ou Acessibilidade"
                                      @bind-Value="PageModel.SpecialNeeds"
                                      Lines="2"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Indicação de recursos de acessibilidade necessários"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Necessidades especiais" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string"
                                      Label="Observações Médicas"
                                      @bind-Value="PageModel.MedicalNotes"
                                      Lines="2"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      HelperText="Alergias, restrições alimentares ou cuidados específicos de saúde"
                                      Disabled="@PageModel.IsBusy"
                                      aria-label="Observações médicas" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end gap-3 mt-6">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="() => PageModel.ResetForm()"
                               Disabled="@PageModel.IsBusy"
                               aria-label="Limpar formulário">
                        Limpar
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit"
                               Disabled="@PageModel.IsBusy"
                               aria-label="Confirmar cadastro do aluno">
                        @if (PageModel.IsBusy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                            <span>Cadastrando...</span>
                        }
                        else
                        {
                            <span>Cadastrar Aluno</span>
                        }
                    </MudButton>
                </div>
            </MudForm>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        PageModel.PropertyChanged += HandlePropertyChanged;
    }

    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PageModel.PropertyChanged -= HandlePropertyChanged;
    }
}

