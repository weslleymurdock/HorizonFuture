@page "/students"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AppPolicies.StudentsRead)]
@inject StudentListPageModel PageModel
@inject NavigationManager Navigation
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@PageModel.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-8">
    <div class="d-flex flex-wrap justify-space-between align-center gap-4 mb-6">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Alunos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Gerenciamento de cadastros, matrículas e informações acadêmicas dos alunos.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => Navigation.NavigateTo("/students/create"))"
                   aria-label="Cadastrar Novo Aluno">
            Novo Aluno
        </MudButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(PageModel.ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.ErrorMessage = null">
            @PageModel.ErrorMessage
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(PageModel.SuccessMessage))
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" Variant="Variant.Filled" CloseIconClicked="() => PageModel.SuccessMessage = null">
            @PageModel.SuccessMessage
        </MudAlert>
    }

    @if (PageModel.IsForbidden)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Outlined">
            Acesso negado: seu perfil não possui a permissão necessária para visualizar a lista de alunos (Students.Read).
        </MudAlert>
    }

    @if (PageModel.IsUnauthorized)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Outlined">
            Sua sessão expirou ou você não está autenticado. Faça login para acessar esta funcionalidade.
        </MudAlert>
    }

    <!-- Barra de Filtros e Busca -->
    <MudCard Elevation="2" Class="pa-4 mb-6">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField T="string"
                              Label="Buscar por matrícula, usuário ou responsável"
                              @bind-Value="PageModel.SearchText"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Clearable="true"
                              aria-label="Filtrar alunos por texto" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="StudentStatus?"
                           Label="Status Operacional"
                           @bind-Value="PageModel.StatusFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           aria-label="Filtrar alunos por status">
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)null)">Todos os Status</MudSelectItem>
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)StudentStatus.Active)">Ativo</MudSelectItem>
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)StudentStatus.Inactive)">Inativo</MudSelectItem>
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)StudentStatus.Graduated)">Graduado</MudSelectItem>
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)StudentStatus.Suspended)">Suspenso</MudSelectItem>
                    <MudSelectItem T="StudentStatus?" Value="@((StudentStatus?)StudentStatus.Transferred)">Transferido</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string"
                              Label="Unidade Escolar (SchoolUnitId)"
                              @bind-Value="PageModel.SchoolUnitIdFilter"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              HelperText="Filtro opcional por ID de unidade"
                              aria-label="Filtrar alunos por ID da Unidade Escolar" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           OnClick="() => PageModel.LoadStudentsAsync()"
                           Disabled="@PageModel.IsBusy"
                           aria-label="Aplicar filtros de alunos">
                    @if (PageModel.IsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-1" />
                        <span>Carregando...</span>
                    }
                    else
                    {
                        <span>Filtrar</span>
                    }
                </MudButton>

                <MudTooltip Text="Limpar Filtros">
                    <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                   Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="() => PageModel.ResetFiltersAsync()"
                                   Disabled="@PageModel.IsBusy"
                                   aria-label="Limpar todos os filtros" />
                </MudTooltip>
            </MudItem>
        </MudGrid>
    </MudCard>

    <!-- Tabela de Alunos -->
    <MudTable Items="PageModel.FilteredStudents"
              Dense="true"
              Hover="true"
              Striped="true"
              Elevation="3"
              Loading="@PageModel.IsBusy"
              Class="mb-4">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<StudentItemDto, object>(x => x.RegistrationNumber)">Matrícula</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<StudentItemDto, object>(x => x.UserId)">ID Usuário</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<StudentItemDto, object>(x => x.DateOfBirth)">Nascimento</MudTableSortLabel></MudTh>
            <MudTh>Responsável</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<StudentItemDto, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
            <MudTh>Unidade</MudTh>
            <MudTh Style="text-align: right;">Ações</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Matrícula">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="font-weight-bold">
                    @context.RegistrationNumber
                </MudChip>
            </MudTd>
            <MudTd DataLabel="ID Usuário">
                <MudText Typo="Typo.body2">@context.UserId</MudText>
            </MudTd>
            <MudTd DataLabel="Nascimento">
                @context.DateOfBirth.ToString("dd/MM/yyyy")
            </MudTd>
            <MudTd DataLabel="Responsável">
                @if (!string.IsNullOrWhiteSpace(context.GuardianName))
                {
                    <MudText Typo="Typo.body2">@context.GuardianName</MudText>
                    @if (!string.IsNullOrWhiteSpace(context.GuardianPhone))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.GuardianPhone</MudText>
                    }
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Não informado</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                    @GetStatusLabel(context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Unidade">
                @(string.IsNullOrWhiteSpace(context.SchoolUnitId) ? "Todas as Unidades" : context.SchoolUnitId)
            </MudTd>
            <MudTd DataLabel="Ações" Style="text-align: right;">
                <div class="d-flex justify-end gap-1">
                    <MudTooltip Text="Visualizar detalhes">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Size="Size.Small"
                                       Color="Color.Info"
                                       aria-label="@($"Visualizar detalhes do aluno {context.RegistrationNumber}")"
                                       OnClick="@(() => Navigation.NavigateTo($"/students/{context.Id}"))" />
                    </MudTooltip>

                    <MudTooltip Text="Editar aluno">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       aria-label="@($"Editar aluno {context.RegistrationNumber}")"
                                       OnClick="@(() => Navigation.NavigateTo($"/students/{context.Id}/edit"))" />
                    </MudTooltip>

                    <MudTooltip Text="Excluir aluno">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Disabled="@(PageModel.IsDeleting && PageModel.DeletingStudentId == context.Id)"
                                       aria-label="@($"Excluir aluno {context.RegistrationNumber}")"
                                       OnClick="@(() => ConfirmDeleteAsync(context))" />
                    </MudTooltip>
                </div>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                <MudText Typo="Typo.h6" Color="Color.Secondary" GutterBottom="true">
                    Nenhum aluno encontrado
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Não há alunos cadastrados com os critérios informados.
                </MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="@(() => Navigation.NavigateTo("/students/create"))">
                    Cadastrar Primeiro Aluno
                </MudButton>
            </div>
        </NoRecordsContent>

        <LoadingContent>
            <div class="pa-8 text-center">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Class="mb-2" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">Carregando listagem de alunos...</MudText>
            </div>
        </LoadingContent>

        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                           RowsPerPageString="Linhas por página:"
                           InfoFormat="{first_item}-{last_item} de {all_items}" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        PageModel.PropertyChanged += HandlePropertyChanged;
        await PageModel.LoadStudentsAsync();
    }

    private void HandlePropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        PageModel.PropertyChanged -= HandlePropertyChanged;
    }

    private async Task ConfirmDeleteAsync(StudentItemDto student)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Confirmar Exclusão",
            $"Deseja realmente excluir o aluno de matrícula '{student.RegistrationNumber}'? Esta operação é irreversível.",
            yesText: "Excluir Aluno",
            cancelText: "Cancelar");

        if (confirm == true)
        {
            await PageModel.DeleteStudentAsync(student.Id);
        }
    }

    private static Color GetStatusColor(StudentStatus status) => status switch
    {
        StudentStatus.Active => Color.Success,
        StudentStatus.Inactive => Color.Warning,
        StudentStatus.Graduated => Color.Info,
        StudentStatus.Suspended => Color.Error,
        StudentStatus.Transferred => Color.Dark,
        _ => Color.Default
    };

    private static string GetStatusLabel(StudentStatus status) => status switch
    {
        StudentStatus.Active => "Ativo",
        StudentStatus.Inactive => "Inativo",
        StudentStatus.Graduated => "Graduado",
        StudentStatus.Suspended => "Suspenso",
        StudentStatus.Transferred => "Transferido",
        _ => status.ToString()
    };
}

