# Database Configuration (used by PostgreSQL service 'db' in docker-compose)
POSTGRES_DB=horizonfuture
POSTGRES_USER=horizon_user
POSTGRES_PASSWORD=your_secure_password_here

# Connection String for Baremetal (host machine connecting to local postgres on localhost)
ConnectionStrings__PostgresConnection=postgresql://horizon_user:your_secure_password_here@localhost:5432/horizonfuture

# Note for Docker Compose:
# Docker Compose automatically constructs ConnectionStrings__PostgresConnection pointing to the internal service 'db:5432'
# using POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB.
# If you need to override the connection string inside docker (e.g. to point to external managed Postgres), uncomment below:
# ConnectionStrings__PostgresConnection=postgresql://user:pass@host:5432/dbname?sslmode=require

# JWT Authentication (Key must have at least 32 characters / 256 bits)
Jwt__Key=HorizonFuture-Development-Secret-Key-Must-Be-At-Least-32-Bytes-Long-123456
Jwt__Issuer=HorizonFuture
Jwt__Audience=HorizonFuture

# Initial Admin Credentials (used by DatabaseSeedHostedService)
ADMIN_EMAIL=admin@horizonfuture.org
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!

# Database Migration Policy (Default: false)
# Set to true to automatically apply pending migrations on startup.
DATABASE_AUTO_MIGRATE=true

TUNNEL_TOKEN=your_cloudflare_tunnel_token_here